# =================== API SERVICE ===================
DATABASE_URL=postgresql://xiom:password@localhost:5432/xiom
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-256-bit-secret-here
JWT_EXPIRY=24h
API_PORT=3001
NODE_ENV=development
PUBLIC_API_URL=http://localhost:3001
PUBLIC_APP_URL=http://localhost:3002
PUBLIC_MARKETING_URL=http://localhost:3000

# =================== NEO4J (LOCAL) ===================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# =================== ROBINHOOD CHAIN (replaces Base) ===================
# Chain IDs: mainnet 4663 | testnet 46630
RH_RPC_URL=https://rpc.robinhoodchain.com
RH_WS_URL=wss://rpc.robinhoodchain.com
RH_TESTNET_RPC_URL=https://rpc.testnet.robinhoodchain.com
RH_TESTNET_WS_URL=wss://rpc.testnet.robinhoodchain.com
RH_ALCHEMY_KEY=your-alchemy-key
RH_ALCHEMY_RPC_URL=
RH_USE_TESTNET=false
RH_WETH_ADDRESS=0x0000000000000000000000000000000000000000
RH_SWAP_ROUTER=0x0000000000000000000000000000000000000000
RH_POOL_FEE=3000

# Blockscout (not Basescan)
BLOCKSCOUT_URL=https://explorer.robinhoodchain.com
BLOCKSCOUT_API_URL=https://explorer.robinhoodchain.com/api
BLOCKSCOUT_API_KEY=
BLOCKSCOUT_TESTNET_URL=https://explorer.testnet.robinhoodchain.com
BLOCKSCOUT_TESTNET_API_URL=https://explorer.testnet.robinhoodchain.com/api

# Native stablecoin USDG (not USDC)
USDG_ADDRESS=0x0000000000000000000000000000000000000000
USDG_TESTNET_ADDRESS=0x0000000000000000000000000000000000000000

# Chainlink ETH/USD on Robinhood Chain (NOT Base)
CHAINLINK_ETH_USD_RH=0x0000000000000000000000000000000000000000

# AXAI / XIOM token + protocol contracts
XIOM_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
BIDWALL_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
