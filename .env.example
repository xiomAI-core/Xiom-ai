# OpenTelemetry (Grafana Cloud / GCP collector)
OTEL_SERVICE_NAME=xiom-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=false

# Telegram notifications (notificationDispatcher / activationQueue)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ACP earnings poller
ACP_API_URL=
ACP_API_KEY=

# GCS graph backups (bucket: xiom-backups)
GCS_BACKUP_BUCKET=xiom-backups
GOOGLE_APPLICATION_CREDENTIALS=

# ERC-4337 EntryPoint v0.7
